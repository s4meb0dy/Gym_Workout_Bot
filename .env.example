# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram user id (ask @userinfobot). The bot ignores everyone else.
# Leave empty only for local testing — then anyone can use the bot and /backup.
OWNER_TELEGRAM_ID=

# Server port (Render sets this automatically)
PORT=3000

# SQLite database path
DATABASE_URL="file:./dev.db"

# Timezone for reminders/digest (IANA name)
TZ_NAME=Europe/Brussels

# Path to the SQLite file (used for backups)
DATABASE_FILE=prisma/dev.db

# Set to "false" to disable reminders/backup scheduler
ENABLE_SCHEDULER=true

# Public URL of this app (e.g. https://my-bot.onrender.com or http://YOUR_VM_IP:3000).
# Required for Apple Watch sync via iOS Shortcuts (POST /api/health/sync).
APP_URL=

# How often (minutes) to self-ping APP_URL/health
KEEPALIVE_MINUTES=10

# Telegram Mini App (needs HTTPS). Either a fixed public URL of /app/ ...
WEBAPP_URL=
# ... or cloudflared metrics, from which the bot reads the quick tunnel address
# (deploy/setup.sh sets this up automatically).
TUNNEL_METRICS_URL=

# Local Mini App dev only: run the HTTP server without the bot, auth as this user
# BOT_DISABLED=true
# WEBAPP_DEV_USER_ID=123456789

# Google Gemini API key for health coaching advice after Apple Watch sync
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the vision model
GEMINI_MODEL=gemini-3.5-flash
